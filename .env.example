# -----------------------------------------------------------------------------
# Atelie OS - environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` for local development.
# Keep production secrets outside git, in your hosting provider secret manager.
# Never expose server-only values with the NEXT_PUBLIC_ prefix.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection used by the app, Drizzle migrations and seed command.
# Local Docker example:
DATABASE_URL="postgresql://atelie:atelie@localhost:5432/atelie_os"

# -----------------------------------------------------------------------------
# App URLs and authentication
# -----------------------------------------------------------------------------
# Public app URL used by browser redirects and auth links.
# Local example:
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth canonical URL. In production use the final HTTPS domain.
# Examples:
# BETTER_AUTH_URL="http://localhost:3000"
# BETTER_AUTH_URL="https://app.seudominio.com.br"
BETTER_AUTH_URL="http://localhost:3000"

# Deployment mode. Default SaaS/dev mode keeps self-serve signup and onboarding.
# Standalone mode is for one self-hosted client, for example:
#   NEXT_PUBLIC_APP_URL="https://app.clientsite.com"
#   BETTER_AUTH_URL="https://app.clientsite.com"
#   ATELIE_DEPLOYMENT_MODE="standalone"
# In standalone, signup/onboarding are disabled and login uses the client copy.
ATELIE_DEPLOYMENT_MODE="saas"
# ATELIE_STANDALONE="true"
# ATELIE_STANDALONE_COMPANY_SLUG="client-slug"
# ATELIE_CLIENT_NAME="Client Brand"
# ATELIE_LOGIN_HEADLINE="Acesse o painel da Client Brand"
# ATELIE_LOGIN_SUBHEADING="Entre para gerenciar pedidos, estoque e producao."

# Long random secret used to sign auth/session data.
# Generate with:
# openssl rand -base64 32
# In production this must be unique, private and stable across deploys.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# -----------------------------------------------------------------------------
# Server-side secret encryption
# -----------------------------------------------------------------------------
# Key used to encrypt tenant integration tokens stored in the database.
# Required in production for Melhor Envio OAuth tokens.
# Use a different value from BETTER_AUTH_SECRET.
# Generate with:
# openssl rand -base64 32
INTEGRATION_SECRETS_KEY="replace-with-another-long-random-secret"

# -----------------------------------------------------------------------------
# OpenAI - bundled AI text generation
# -----------------------------------------------------------------------------
# Server-only API key for Atelie OS. Tenants do not provide their own key.
# The cost can be included in the SaaS subscription because requests are routed
# through /api/app/ai/generate on the backend.
# Example format:
# OPENAI_API_KEY="sk-proj-..."
OPENAI_API_KEY=""

# Default model for text generation. Use a smaller model for lower latency/cost.
# Current default used by the app when unset:
OPENAI_TEXT_MODEL="gpt-5.4-mini"

# -----------------------------------------------------------------------------
# Resend - transactional email
# -----------------------------------------------------------------------------
# Required in production for password reset, magic link sign-in and team invites.
# RESEND_FROM_EMAIL must be a verified sender/domain in Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Atelie OS <noreply@seudominio.com.br>"

# -----------------------------------------------------------------------------
# Melhor Envio - multi-tenant OAuth
# -----------------------------------------------------------------------------
# These values identify YOUR SaaS application in Melhor Envio.
# They are global for the deployment, not per tenant.
# Each tenant connects its own Melhor Envio account through OAuth; the resulting
# access/refresh tokens are encrypted in the database by company_id + provider.

# Use "sandbox" for homologation and "production" for live accounts.
MELHOR_ENVIO_ENV="sandbox"

# OAuth app credentials from Melhor Envio.
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""

# Must match the callback configured in Melhor Envio.
# Local example:
# MELHOR_ENVIO_REDIRECT_URI="http://localhost:3000/api/app/shipping/oauth/callback"
# Production example:
# MELHOR_ENVIO_REDIRECT_URI="https://app.seudominio.com.br/api/app/shipping/oauth/callback"
MELHOR_ENVIO_REDIRECT_URI="http://localhost:3000/api/app/shipping/oauth/callback"

# OAuth scopes requested when each tenant connects.
MELHOR_ENVIO_SCOPES="shipping-calculate shipping-checkout shipping-generate shipping-preview shipping-print shipping-tracking cart-read cart-write"

# Optional endpoint overrides. Leave blank unless Melhor Envio changes endpoints
# or you need a custom homologation URL.
MELHOR_ENVIO_WEB_URL=""
MELHOR_ENVIO_API_URL=""
MELHOR_ENVIO_AUTH_URL=""
MELHOR_ENVIO_TOKEN_URL=""

# Required by Melhor Envio API calls. Use the app name and a technical contact.
MELHOR_ENVIO_USER_AGENT="Atelie OS (suporte@atelie-os.local)"

# Webhook URL to register in Melhor Envio when using the local ngrok tunnel:
# https://ablutionary-unvesiculated-marylynn.ngrok-free.dev/api/app/shipping/webhook/melhor-envio

# -----------------------------------------------------------------------------
# Mercado Livre - marketplace OAuth foundation
# -----------------------------------------------------------------------------
# OAuth app credentials from Mercado Livre DevCenter.
MERCADO_LIVRE_CLIENT_ID=""
MERCADO_LIVRE_CLIENT_SECRET=""

# Must match the redirect URL configured in Mercado Livre.
# Local/ngrok example:
# MERCADO_LIVRE_REDIRECT_URI="https://your-ngrok-domain.ngrok-free.app/api/app/integrations/mercado-livre/oauth/callback"
# Production example:
# MERCADO_LIVRE_REDIRECT_URI="https://app.seudominio.com.br/api/app/integrations/mercado-livre/oauth/callback"
MERCADO_LIVRE_REDIRECT_URI=""

# Optional endpoint overrides. Leave blank unless Mercado Livre changes endpoints.
MERCADO_LIVRE_API_URL=""
MERCADO_LIVRE_AUTH_URL=""
MERCADO_LIVRE_TOKEN_URL=""

# Webhook URL to register in Mercado Livre while testing:
# https://your-ngrok-domain.ngrok-free.app/api/webhooks/mercado-livre

# -----------------------------------------------------------------------------
# Nuvemshop - e-commerce platform OAuth foundation
# -----------------------------------------------------------------------------
# App credentials from Nuvemshop/Tiendanube Partners.
NUVEMSHOP_APP_ID=""
NUVEMSHOP_CLIENT_ID=""
NUVEMSHOP_CLIENT_SECRET=""

# Must match the redirect URL configured in Nuvemshop.
# Local/ngrok example:
# NUVEMSHOP_REDIRECT_URI="https://your-ngrok-domain.ngrok-free.app/api/app/integrations/nuvemshop/oauth/callback"
# Production example:
# NUVEMSHOP_REDIRECT_URI="https://app.seudominio.com.br/api/app/integrations/nuvemshop/oauth/callback"
NUVEMSHOP_REDIRECT_URI=""

# Required by Nuvemshop API calls.
NUVEMSHOP_USER_AGENT="Atelie OS (suporte@atelie-os.local)"

# Optional endpoint overrides. Leave blank unless Nuvemshop changes endpoints.
NUVEMSHOP_WEB_URL=""
NUVEMSHOP_API_URL=""
NUVEMSHOP_AUTH_URL=""
NUVEMSHOP_TOKEN_URL=""

# Webhook URL to register in Nuvemshop while testing:
# https://your-ngrok-domain.ngrok-free.app/api/webhooks/nuvemshop

# -----------------------------------------------------------------------------
# Seed bootstrap values
# -----------------------------------------------------------------------------
# Used only by `npm run db:seed` to create/update local demo data.
SEED_COMPANY_NAME=""
SEED_OWNER_NAME=""
SEED_OWNER_EMAIL="admin@example.com"
SEED_OWNER_PASSWORD=""
